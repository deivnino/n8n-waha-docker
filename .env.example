# Plantilla de variables de entorno — copiar a .env y completar
# PowerShell: Copy-Item .env.example .env

# ============ WAHA (WhatsApp HTTP API) ============
WAHA_API_KEY=
WAHA_DASHBOARD_USERNAME=admin
WAHA_DASHBOARD_PASSWORD=
WAHA_DASHBOARD_ENABLED=true
WHATSAPP_SWAGGER_USERNAME=admin
WHATSAPP_SWAGGER_PASSWORD=
WHATSAPP_SWAGGER_ENABLED=true
WHATSAPP_DEFAULT_ENGINE=WEBJS
WAHA_BASE_URL=http://localhost:3000
WAHA_LOG_FORMAT=JSON
WAHA_LOG_LEVEL=info
WAHA_PRINT_QR=false
WAHA_MEDIA_STORAGE=LOCAL
WHATSAPP_FILES_LIFETIME=180
WHATSAPP_FILES_FOLDER=/tmp/whatsapp-files

# ============ Postgres ============
POSTGRES_DB=chatwoot
POSTGRES_USER=chatwoot
POSTGRES_PASSWORD=tu_password_seguro

# ============ pgAdmin (servicio opcional, comentado en compose) ============
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=admin

# ============ Chatwoot (servicio opcional, comentado en compose) ============
CHATWOOT_FRONTEND_URL=http://localhost:3001
CHATWOOT_SECRET_KEY_BASE=
CHATWOOT_FORCE_SSL=false
CHATWOOT_DEFAULT_LOCALE=es

# ============ APIs externas ============
ANTHROPIC_API_KEY=
FIRECRAWL_API_KEY=

# ============ n8n API (generar en n8n UI: Settings > n8n API) ============
N8N_API_KEY=
